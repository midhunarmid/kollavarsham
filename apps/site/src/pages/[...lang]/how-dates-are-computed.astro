---
// How the calendar computes dates, in plain words. Each section is also a
// question and answer in the page's FAQPage structured data, built from
// the same text.
import Base from '../../layouts/Base.astro';
import { breadcrumbs, href, langOf, langParam, langs, t } from '../../lib/i18n';
import type { Lang } from '../../lib/data';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang: langParam(lang) } }));
}

const lang: Lang = langOf(Astro.params.lang);
const ml = lang === 'ml';
const title = ml ? 'തീയതികൾ കണക്കാക്കുന്ന വിധം' : 'How dates are computed';
const repo = 'https://github.com/midhunarmid/kollavarsham';
const link = (url: string, text: string) => `<a href="${url}">${text}</a>`;

// [heading, question for search engines, answer as HTML].
const sections: [string, string, string][] = ml
  ? [
      ['മാസാരംഭം', 'മലയാള മാസം തുടങ്ങുന്നത് എങ്ങനെ കണക്കാക്കുന്നു?',
        'സൂര്യൻ ഒരു രാശിയിൽ കടക്കുന്ന നിമിഷമാണ് സംക്രമം (ലാഹിരി അയനാംശം). കേരളത്തിലെ രീതിയനുസരിച്ച്, സംക്രമം പകലിന്റെ ആദ്യ അഞ്ചിൽ മൂന്ന് ഭാഗത്തിനുള്ളിലാണെങ്കിൽ അന്ന് മാസം ഒന്ന്; അല്ലെങ്കിൽ പിറ്റേന്ന്. സംക്രമം ഈ അതിർത്തിയോട് ഏതാനും മിനിറ്റ് അടുത്താണെങ്കിൽ പഞ്ചാംഗങ്ങൾ തമ്മിൽ വ്യത്യാസം വരാം; അത്തരം ദിവസങ്ങളിൽ സൈറ്റും ആപ്പും ഒരു കുറിപ്പ് കാണിക്കും.'],
      ['നക്ഷത്രവും തിഥിയും', 'ഒരു ദിവസത്തെ നക്ഷത്രവും തിഥിയും ഏതാണ്?',
        'ഒരു ദിവസത്തെ നക്ഷത്രവും തിഥിയും സൂര്യോദയത്തിൽ നിലവിലുള്ളതാണ്. ദിവസത്തെ പേജുകളിൽ അടുത്ത സൂര്യോദയം വരെയുള്ള എല്ലാ നക്ഷത്രങ്ങളും തിഥികളും അവസാനിക്കുന്ന സമയത്തോടെ കാണാം.'],
      ['പിറന്നാൾ', 'നക്ഷത്ര പിറന്നാൾ (പിറന്നാൾ) എങ്ങനെ കണ്ടെത്തുന്നു?',
        `ജന്മമാസത്തിൽ ജന്മനക്ഷത്രം വരുന്ന ദിവസം. സൂര്യോദയം കഴിഞ്ഞ് 6 നാഴിക (ഏകദേശം 2 മണിക്കൂർ 24 മിനിറ്റ്) സമയത്തെ നക്ഷത്രമാണ് നോക്കുന്നത്. മാസത്തിൽ രണ്ടു തവണ വന്നാൽ രണ്ടാമത്തേത് (ആപ്പിൽ മാറ്റാം). ${link(href(lang, '/pirannal/'), 'പിറന്നാൾ തീയതികൾ കണ്ടെത്തുക')}.`],
      ['വിശേഷങ്ങൾ', 'വിശേഷങ്ങളുടെ തീയതി എങ്ങനെ നിശ്ചയിക്കുന്നു?',
        'ഓരോ വിശേഷത്തിന്റെയും നിയമം അതിന്റെ പേജിൽ കാണാം; ഓരോന്നും കുറഞ്ഞത് അഞ്ചു വർഷത്തെ പ്രസിദ്ധീകരിച്ച തീയതികളുമായി ഒത്തുനോക്കിയതാണ്. മുസ്ലിം വിശേഷങ്ങൾ ചന്ദ്രനെ കാണുന്നതനുസരിച്ചാണ്; സർക്കാർ പ്രഖ്യാപിക്കുംവരെ താൽക്കാലികം. സർക്കാർ അവധികൾ ഔദ്യോഗിക പട്ടികയിൽ നിന്ന്.'],
      ['സമയങ്ങൾ', 'സമയങ്ങൾ ഏതു സ്ഥലത്തേതാണ്?',
        'പേജുകൾ തിരുവനന്തപുരത്തേക്ക് (IST) കണക്കാക്കിയതാണ്. മുകളിലെ "സ്ഥലം" തിരഞ്ഞെടുത്താൽ സമയങ്ങൾ നിങ്ങളുടെ ബ്രൗസറിൽ ആ സ്ഥലത്തേക്ക് വീണ്ടും കണക്കാക്കും; മലയാള തീയതികൾ കേരളത്തിലേത് തന്നെ. ആപ്പിൽ ഏതു സ്ഥലവും തിരഞ്ഞെടുക്കാം.'],
      ['തെറ്റ് കണ്ടാൽ', 'ഒരു തീയതി പഞ്ചാംഗവുമായി യോജിക്കുന്നില്ലെങ്കിൽ എന്തു ചെയ്യണം?',
        `പഞ്ചാംഗത്തിന്റെ പേരും വർഷവും സഹിതം ${link(`${repo}/issues`, 'GitHub-ൽ അറിയിക്കുക')}. ഓരോ ദിവസത്തെ പേജിലും ആപ്പിലും “തെറ്റായ തീയതി അറിയിക്കുക” ഉണ്ട്.`],
    ]
  : [
      ['Month starts', 'How is the start of a Malayalam month found?',
        'A Malayalam month begins at the <em>sankranti</em>, the moment the Sun enters a sign of the zodiac (sidereal, Lahiri ayanamsa). Following the Kerala rule, if the sankranti falls within the first three-fifths of the daytime, that day is the 1st of the month; otherwise the next day is. When the sankranti is within a few minutes of that cut-off, almanacs can disagree; the site and the app note such days.'],
      ['Star and tithi', 'Which star and tithi belong to a day?',
        'A day’s nakshatra and tithi are the ones prevailing at sunrise. Each day page lists every star and tithi until the next sunrise, with the times they end.'],
      ['Star birthdays (pirannal)', 'How is a star birthday (pirannal) found?',
        `The day in the birth Malayalam month when the birth star falls, read at 6 nazhika (about 2 h 24 min) after sunrise. When the star falls twice in the month, the second day is used by default; the app lets you choose. The rules and their sources are in ${link(`${repo}/blob/main/docs/pirannal-rules.md`, 'pirannal-rules.md')}. ${link(href(lang, '/pirannal/'), 'Find your pirannal dates')}.`],
      ['Festivals', 'How are festival dates decided?',
        `Each festival’s rule is on its page, and each was checked against at least five years of published dates. Muslim festivals follow the sighting of the moon and stay tentative until announced. Government holidays come from the published Kerala holiday list. How closely the computed values match published ones is recorded in ${link(`${repo}/blob/main/docs/accuracy.md`, 'accuracy.md')}.`],
      ['Times', 'Which place are the times for?',
        'Pages are computed for Thiruvananthapuram (IST). Choose another place at the top of any page and the times are computed again in your browser; Malayalam dates stay Kerala’s. In the app, choose any city or place.'],
      ['Found a difference?', 'What if a date doesn’t match my almanac?',
        `Please ${link(`${repo}/issues`, 'open an issue on GitHub')} with the almanac’s name and year. Each day page, and each day in the app, has “Report a wrong date”.`],
    ];

const lede = ml
  ? 'എല്ലാ തീയതികളും ഒരു പട്ടികയിൽ നിന്നല്ല, സൂര്യന്റെയും ചന്ദ്രന്റെയും സ്ഥാനം കണക്കാക്കി കണ്ടെത്തുന്നതാണ്. അതിനാൽ ഏതു വർഷത്തിനും ഏതു സ്ഥലത്തിനും പ്രവർത്തിക്കും.'
  : 'Dates are not looked up in a table: they are computed from the positions of the Sun and Moon, so they work for any year and any place.';
const text = (html: string) => html.replace(/<[^>]+>/g, '');
---
<Base lang={lang} path="/how-dates-are-computed/" title={title}
  description={ml ? 'മാസാരംഭം, നക്ഷത്രം, തിഥി, വിശേഷങ്ങൾ, പിറന്നാൾ എന്നിവ കണക്കാക്കുന്നത് എങ്ങനെ.' : 'How the calendar finds month starts, stars, tithis, festivals and star birthdays.'}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: ml ? 'ml-IN' : 'en-IN',
      mainEntity: sections.map(([, q, a]) => ({
        '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: text(a) },
      })),
    },
    breadcrumbs(lang, [[title, '/how-dates-are-computed/']]),
  ]}>
  <h1>{title}</h1>
  <p class="lede">{lede}</p>
  {sections.map(([heading, , answer]) => (
    <>
      <h2>{heading}</h2>
      <p set:html={answer} />
    </>
  ))}
  <p><a href={href(lang, '/converter/')}>{t(lang, 'converter')} →</a> · <a href={href(lang, '/glossary/')}>{t(lang, 'glossary')} →</a></p>
</Base>
