---
// Every page: head (title, description, canonical, hreflang, Open Graph,
// JSON-LD), header with navigation and language switch, and footer.
// Fonts are bundled with the site (no third-party requests): Noto Sans for
// Latin text and Noto Sans Malayalam for Malayalam, in the weights used.
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-600.css';
import '@fontsource/noto-sans/latin-700.css';
import '@fontsource/noto-sans-malayalam/malayalam-400.css';
import '@fontsource/noto-sans-malayalam/malayalam-600.css';
import '@fontsource/noto-sans-malayalam/malayalam-700.css';
import latinRegular from '@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff2?url';
import malayalamRegular from '@fontsource/noto-sans-malayalam/files/noto-sans-malayalam-malayalam-400-normal.woff2?url';
import '../styles/site.css';
import { href, t } from '../lib/i18n';
import { keralaToday, type Lang } from '../lib/data';

interface Props {
  lang: Lang;
  /** Path without the language prefix, e.g. "/day/2026-11-02/". */
  path: string;
  title: string;
  description: string;
  /** Structured data (schema.org) for this page: one node or several. */
  jsonLd?: object | object[];
  /** Social preview image (a site path), instead of the shared /og.png. */
  ogImage?: string;
  /** False for pages that exist in one language only. */
  alternates?: boolean;
  /** Whether site search (Pagefind) indexes this page. */
  searchable?: boolean;
}

const { lang, path, title, description, jsonLd, ogImage = '/og.png', alternates = true, searchable = false } = Astro.props;
const site = 'https://calendar.armid.in';
const canonical = `${site}${href(lang, path)}`;
const other: Lang = lang === 'en' ? 'ml' : 'en';
const fullTitle = path === '/' ? title : `${title} · ${t(lang, 'siteName')}`;
const nav = [
  ['/', t(lang, 'today')],
  ['/calendar/' + keralaToday().slice(0, 4) + '/', t(lang, 'calendar')],
  ['/festivals/', t(lang, 'festivals')],
  ['/nakshatra-today/', t(lang, 'nakshatraToday')],
  ['/converter/', t(lang, 'converter')],
  ['/search/', t(lang, 'search')],
];
---
<!doctype html>
<html lang={lang === 'ml' ? 'ml-IN' : 'en-IN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en-IN" href={`${site}${href('en', path)}`} />
        <link rel="alternate" hreflang="ml-IN" href={`${site}${href('ml', path)}`} />
        <link rel="alternate" hreflang="x-default" href={`${site}${href('en', path)}`} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, 'siteName')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:locale" content={lang === 'ml' ? 'ml_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#00796b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={lang === 'ml' ? malayalamRegular : latinRegular} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={href(lang, '/')}>
          <span class="brand-mark" aria-hidden="true">൧</span>
          <span>{t(lang, 'siteName')}</span>
        </a>
        <label class="place" hidden
          data-lang={lang}
          data-groups={JSON.stringify([t(lang, 'placesKerala'), t(lang, 'placesIndia'), t(lang, 'placesAbroad')])}>
          <span>{t(lang, 'place')}</span>
          <select id="place"></select>
        </label>
        {alternates && (
          <a class="lang-switch" href={href(other, path)} hreflang={other} lang={other}>
            {t(lang, 'language')}
          </a>
        )}
      </div>
      <nav class="wrap site-nav" aria-label={t(lang, 'calendar')}>
        {nav.map(([p, label]) => <a href={href(lang, p)}>{label}</a>)}
        <a class="app-link" href="/app/">{t(lang, 'openApp')}</a>
      </nav>
    </header>
    <main id="main" class="wrap" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
      <p class="print-only print-source" data-pagefind-ignore>{t(lang, 'siteName')} · calendar.armid.in · {t(lang, 'timesNote')}</p>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t(lang, 'footer')}</p>
        <nav class="footer-links" aria-label={t(lang, 'contact')}>
          <a href={href(lang, '/how-dates-are-computed/')}>{t(lang, 'howComputed')}</a>
          <a href={href(lang, '/glossary/')}>{t(lang, 'glossary')}</a>
          <a href={href(lang, '/privacy/')}>{t(lang, 'privacy')}</a>
          <a href={href(lang, '/contact/')}>{t(lang, 'contact')}</a>
          <a href={href(lang, '/api/')}>Data / API</a>
          <a href="https://github.com/midhunarmid/kollavarsham">GitHub</a>
        </nav>
      </div>
    </footer>
    <script>
      import { initPicker } from '../client/place';
      initPicker();
    </script>
  </body>
</html>
